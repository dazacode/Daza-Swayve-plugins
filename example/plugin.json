{
  "schemaVersion": 1,
  "id": "app.swayve.plugins.example",
  "name": "Example Plugin",
  "description": "A teaching reference plugin. Serves a small hand-written catalogue for search and browsing, entirely offline, with no permissions and no playback.",
  "version": "0.1.0",
  "author": {
    "name": "Swayve",
    "url": "https://github.com/dazacode/swayve-plugins"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/dazacode/swayve-plugins/tree/main/plugins/example",
  "repository": "https://github.com/dazacode/swayve-plugins",
  "swayvePluginApi": 1,
  "minimumSwayveVersion": "0.1.0",
  "runtime": "compiled",
  "platforms": ["android", "ios", "windows", "macos", "linux"],
  "capabilities": ["search", "catalog"],
  "permissions": [],
  "entrypoint": "example",
  "media": {
    "streamable": false,
    "downloadable": false,
    "offlineCache": false
  },
  "keywords": ["example", "reference", "offline", "fixture", "tutorial"]
