# ---------------------------------------------------------------------------
# Daza-Swayve-plugins — multi-package Dart repository (NOT a pub workspace).
# Each plugin resolves independently, so build output appears in every
# plugin directory, not just at the root.
# ---------------------------------------------------------------------------

# Dart / pub build output (every plugin directory)
.dart_tool/
.packages
.pub/
.pub-cache/
build/
doc/api/
coverage/
*.dart.js
*.js_
*.js.deps
*.js.map

# pubspec.lock policy: every plugin here is a *library*, consumed against a
# range of dependency versions (including the SDK, pinned by `ref:` in each
# plugin's pubspec.yaml rather than by a lockfile). Committing lockfiles would
# pin CI to one resolution and hide breakage a real consumer would hit.
*/pubspec.lock

# Flutter (a future plugin here may be a Flutter package)
.flutter-plugins
.flutter-plugins-dependencies
.metadata
**/ios/Flutter/.last_build_id
**/android/.gradle/

# IDEs / editors
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.history/
*.swp
*.swo
*~

# Claude Code harness state — local to whoever's machine ran it.
.claude/

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
