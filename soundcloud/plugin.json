{
  "schemaVersion": 4,
  "id": "app.swayve.plugins.soundcloud",
  "name": "SoundCloud",
  "description": "Adds SoundCloud search, browsing and playback to Swayve.",
  "version": "0.3.1",
  "author": {
    "name": "Swayve",
    "url": "https://github.com/dazacode/swayve-plugins"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/dazacode/swayve-plugins/tree/main/plugins/soundcloud",
  "repository": "https://github.com/dazacode/swayve-plugins",
  "swayvePluginApi": 1,
  "minimumSwayveVersion": "0.1.0",
  "runtime": "compiled",
  "platforms": [
    "android",
    "ios",
    "windows",
    "linux"
  ],
  "capabilities": [
    "search",
    "catalog",
    "streaming",
    "artwork",
    "playlist_read",
    "artist_activity",
    "authentication",
    "personal_library",
    "webview"
  ],
  "permissions": [
    "network",
    "webview",
    "external_auth"
  ],
  "entrypoint": "soundcloud",
  "source": {
    "sourceId": "soundcloud",
    "displayName": "SoundCloud",
    "iconName": "soundcloud",
    "contentTypes": [
      "songs",
      "albums",
      "artists"
    ]
  },
  "media": {
    "streamable": true,
    "downloadable": true,
    "offlineCache": false
  },
  "network": {
    "hosts": [
      "soundcloud.com",
      "api-v2.soundcloud.com",
      "api.soundcloud.com",
      "secure.soundcloud.com",
      "*.sndcdn.com"
    ]
  },
  "timeouts": {
    "requestMs": 10000,
    "operationMs": 20000
  },
  "settings": [
    {
      "id": "client_id",
      "type": "secret",
      "label": "SoundCloud API client ID",
      "description": "Your own registered SoundCloud app's client ID. Needed to see your liked tracks — see README.md. Stored on this device, sent only to SoundCloud."
    },
    {
      "id": "client_secret",
      "type": "secret",
      "label": "SoundCloud API client secret",
      "description": "Your own registered SoundCloud app's client secret, from the same place as the client ID. Stored on this device, sent only to SoundCloud."
    },
    {
      "id": "region",
      "type": "select",
      "label": "Chart region",
      "description": "Region sent to SoundCloud's charts feed, which backs track browsing. Leave on Global for the worldwide chart.",
      "default": "global",
      "options": [
        {
          "value": "global",
          "label": "Global"
        },
        {
          "value": "US",
          "label": "United States"
        },
        {
          "value": "GB",
          "label": "United Kingdom"
        },
        {
          "value": "DE",
          "label": "Germany"
        },
        {
          "value": "BR",
          "label": "Brazil"
        }
      ]
    }
  ],
  "keywords": [
    "soundcloud",
    "music",
    "streaming",
    "search",
    "catalog"
  ],
  "icon": "assets/icon.svg"
}
